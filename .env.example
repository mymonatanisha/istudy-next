# Server-only YouTube Data API v3 key.
# Create/restrict this key in Google Cloud Console.
# Never commit a real API key.
YT_API_KEY="your-youtube-api-key-here"

# Server-only signed Cloudinary storage for Blog Admin images.
# Never commit the API secret.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
