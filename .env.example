# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# This is a template file showing which environment variables are needed.
# To use these variables:
# 1. Copy this file to .env.local (or .env)
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit .env.local to Git - it's git-ignored by default
# 4. Restart your dev server after creating .env.local for changes to take effect
# ==============================================================================

# Database Configuration
# PostgreSQL database connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# For Heroku: This is automatically set when you add heroku-postgresql addon
# Example: postgresql://user:password@localhost:5432/istudy_db?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/istudy_db?schema=public"

# Optional: Shadow database URL for Prisma Migrate (only needed in development)
# SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/istudy_shadow_db?schema=public"

# JWT Configuration (required for authentication)
# Generate a random secret string for production
# Example: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Next.js Configuration
# Base URL for the application (used for API calls and redirects)
# For Heroku: https://your-app-name.herokuapp.com
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Node Environment
# Use "production" for Heroku deployment
NODE_ENV="development"

# YouTube Data API v3 Configuration (optional)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# This key is used to fetch YouTube playlist data server-side
# If not provided, the playlist will use iframe embed fallback
# SECURITY: Consider adding API key restrictions in Google Cloud Console
YT_API_KEY="your-youtube-api-key"
