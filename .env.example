# Database Configuration
# Copy this file to .env and fill in your actual values

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://user:password@localhost:5432/istudy_dev"

# Optional: Shadow database for Prisma migrations (recommended for production)
# SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/istudy_shadow"

# Application Settings
NODE_ENV="development"

# JWT Secret (generate a random string for production)
JWT_SECRET="your-secret-key-here-change-in-production"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="200696712980-4tclhjfvr8u83hj4fo18mj3gofk3oegi.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="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"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here-change-in-production"

