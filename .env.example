# Server-only YouTube Data API v3 key.
# Create/restrict this key in Google Cloud Console.
# Never commit a real API key.
YT_API_KEY="your-youtube-api-key-here"

# Cloudinary unsigned upload configuration for Blog Admin images.
# Create an unsigned upload preset restricted to images and the desired folder.
# Never commit a Cloudinary API secret.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_UPLOAD_PRESET="your-unsigned-upload-preset"
