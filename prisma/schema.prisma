generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  createdAt DateTime @default(now())
  userId    Int?
  user      user?    @relation(fields: [userId], references: [id])
}

model accounts {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model admin_logs {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  entityType String
  entityId   Int?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([createdAt])
  @@index([entityType])
  @@index([userId])
}

model announcements {
  id          Int       @id @default(autoincrement())
  title       String
  content     String
  type        String    @default("info")
  target      String    @default("all")
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  createdBy   Int
  user        user      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([isPublished])
  @@index([target])
}

model blog_posts {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  status      String    @default("draft")
  publishedAt DateTime?
  authorId    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  user        user?     @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([publishedAt])
  @@index([slug])
  @@index([status])
}

model contact_messages {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

model course_drafts {
  id                                 Int      @id @default(autoincrement())
  courseId                           Int
  createdBy                          Int
  updatedBy                          Int?
  draftData                          Json
  version                            Int      @default(1)
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime
  courses                            courses  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user_course_drafts_createdByTouser user     @relation("course_drafts_createdByTouser", fields: [createdBy], references: [id], onDelete: Cascade)
  user_course_drafts_updatedByTouser user?    @relation("course_drafts_updatedByTouser", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([courseId])
  @@index([createdBy])
  @@index([updatedAt])
}

model course_modules {
  id          Int       @id @default(autoincrement())
  courseId    Int
  title       String
  description String?
  orderIndex  Int
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  courses     courses   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     lessons[]

  @@index([courseId])
  @@index([orderIndex])
}

model courses {
  id                Int               @id @default(autoincrement())
  legacyId          Int?              @unique
  isLegacy          Boolean           @default(false)
  title             String
  slug              String?           @unique
  courseTag         String?
  badge             String?
  badgeClass        String?
  instructorName    String
  instructorAvatar  String?
  instructorId      Int?
  lessons           Int               @default(0)
  students          Int               @default(0)
  rating            Decimal?          @db.Decimal(3, 2)
  price             Decimal           @db.Decimal(10, 2)
  oldPrice          Decimal?          @db.Decimal(10, 2)
  courseDescription String?
  shortDescription  String?           @db.VarChar(500)
  thumbnail         String?
  coverImage        String?
  status            String            @default("published")
  featured          Boolean           @default(false)
  createdAt         DateTime          @default(now()) @db.Timestamp(6)
  updatedAt         DateTime          @default(now()) @db.Timestamp(6)
  publishedAt       DateTime?         @db.Timestamp(6)
  course_drafts     course_drafts[]
  course_modules    course_modules[]
  user              user?             @relation(fields: [instructorId], references: [id], onUpdate: NoAction, map: "fk_courses_instructor")
  enrollments       enrollments[]
  revenue_records   revenue_records[]

  @@index([featured])
  @@index([instructorId])
  @@index([status])
}

model enrollments {
  id              Int               @id @default(autoincrement())
  studentId       Int
  courseId        Int
  orderId         Int?              @unique
  status          String            @default("active")
  progress        Decimal           @default(0) @db.Decimal(5, 2)
  enrolledAt      DateTime          @default(now()) @db.Timestamp(6)
  lastAccessedAt  DateTime          @default(now()) @db.Timestamp(6)
  completedAt     DateTime?         @db.Timestamp(6)
  expiresAt       DateTime?         @db.Timestamp(6)
  updatedAt       DateTime          @default(now()) @db.Timestamp(6)
  courses         courses           @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_enrollments_course")
  orders          orders?           @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_enrollments_order")
  user            user              @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_enrollments_student")
  lesson_progress lesson_progress[]

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([enrolledAt])
  @@index([status])
  @@index([studentId])
}

model instructor_profiles {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  verificationStatus String    @default("pending")
  verifiedAt         DateTime?
  verificationNotes  String?
  totalStudents      Int       @default(0)
  totalCourses       Int       @default(0)
  totalRevenue       Decimal   @default(0) @db.Decimal(10, 2)
  averageRating      Float     @default(0)
  payoutEmail        String?
  bankAccount        String?
  taxId              String?
  expertise          String?
  certifications     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  user               user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([verificationStatus])
}

model lesson_attachments {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  fileName  String
  fileUrl   String
  fileSize  Int?
  fileType  String?
  createdAt DateTime @default(now())
  lessons   lessons  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model lesson_progress {
  id            Int         @id @default(autoincrement())
  enrollmentId  Int
  lessonId      Int
  userId        Int
  isCompleted   Boolean     @default(false)
  progress      Float       @default(0)
  watchTime     Int         @default(0)
  startedAt     DateTime    @default(now())
  completedAt   DateTime?
  lastWatchedAt DateTime    @default(now())
  enrollments   enrollments @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessons       lessons     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user          user        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
  @@index([userId])
}

model lessons {
  id                 Int                  @id @default(autoincrement())
  moduleId           Int
  title              String
  description        String?
  contentType        String               @default("video")
  videoUrl           String?
  duration           Int?
  content            String?
  orderIndex         Int
  isFree             Boolean              @default(false)
  isPublished        Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  lesson_attachments lesson_attachments[]
  lesson_progress    lesson_progress[]
  course_modules     course_modules       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@index([orderIndex])
}

model orders {
  id              Int               @id @default(autoincrement())
  fullName        String
  phone           String
  email           String
  courseId        Int
  paymentMethod   String
  transactionId   String
  status          String            @default("pending")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  userId          Int?
  enrollments     enrollments?
  refund_requests refund_requests[]
  revenue_records revenue_records[]

  @@index([courseId])
  @@index([createdAt])
  @@index([email])
  @@index([status])
  @@index([userId])
}

model refund_requests {
  id          Int       @id @default(autoincrement())
  orderId     Int
  userId      Int
  reason      String
  amount      Decimal   @db.Decimal(10, 2)
  status      String    @default("pending")
  adminNotes  String?
  processedBy Int?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  orders      orders    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([orderId])
  @@index([status])
  @@index([userId])
}

model revenue_records {
  id              Int       @id @default(autoincrement())
  orderId         Int
  courseId        Int
  amount          Decimal   @db.Decimal(10, 2)
  instructorShare Decimal   @default(0) @db.Decimal(10, 2)
  platformFee     Decimal   @default(0) @db.Decimal(10, 2)
  status          String    @default("pending")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  courses         courses   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orders          orders    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([createdAt])
  @@index([orderId])
  @@index([status])
}

model roles {
  id   Int    @id @default(autoincrement())
  name String @unique
  user user[]
}

model support_tickets {
  id             Int              @id @default(autoincrement())
  ticketNumber   String           @unique
  userId         Int
  subject        String
  category       String           @default("general")
  priority       String           @default("medium")
  status         String           @default("open")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  resolvedAt     DateTime?
  user           user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket_replies ticket_replies[]

  @@index([createdAt])
  @@index([priority])
  @@index([status])
  @@index([ticketNumber])
  @@index([userId])
}

model system_settings {
  id                                   Int      @id @default(autoincrement())
  key                                  String   @unique
  value                                String
  dataType                             String   @default("string")
  category                             String?
  description                          String?
  isPublic                             Boolean  @default(false)
  createdAt                            DateTime @default(now())
  updatedAt                            DateTime
  createdBy                            Int?
  updatedBy                            Int?
  user_system_settings_createdByTouser user?    @relation("system_settings_createdByTouser", fields: [createdBy], references: [id])
  user_system_settings_updatedByTouser user?    @relation("system_settings_updatedByTouser", fields: [updatedBy], references: [id])

  @@index([category])
  @@index([key])
}

model ticket_replies {
  id              Int             @id @default(autoincrement())
  ticketId        Int
  userId          Int
  message         String
  isStaff         Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  support_tickets support_tickets @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user            user            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([ticketId])
  @@index([userId])
}

model user {
  id                                              Int                  @id(map: "User_pkey") @default(autoincrement())
  name                                            String
  email                                           String               @unique
  passwordHash                                    String?
  resetToken                                      String?
  resetTokenExpires                               DateTime?
  createdAt                                       DateTime?            @default(now())
  updatedAt                                       DateTime?
  role_id                                         Int?
  username                                        String?
  phone                                           String?
  avatar                                          String?
  linkedIn                                        String?
  bio                                             String?
  occupation                                      String?
  address                                         String?
  headline                                        String?
  Note                                            Note[]
  accounts                                        accounts[]
  admin_logs                                      admin_logs[]
  announcements                                   announcements[]
  blog_posts                                      blog_posts[]
  course_drafts_course_drafts_createdByTouser     course_drafts[]      @relation("course_drafts_createdByTouser")
  course_drafts_course_drafts_updatedByTouser     course_drafts[]      @relation("course_drafts_updatedByTouser")
  courses                                         courses[]
  enrollments                                     enrollments[]
  instructor_profiles                             instructor_profiles?
  lesson_progress                                 lesson_progress[]
  refund_requests                                 refund_requests[]
  support_tickets                                 support_tickets[]
  system_settings_system_settings_createdByTouser system_settings[]    @relation("system_settings_createdByTouser")
  system_settings_system_settings_updatedByTouser system_settings[]    @relation("system_settings_updatedByTouser")
  ticket_replies                                  ticket_replies[]
  roles                                           roles?               @relation(fields: [role_id], references: [id], map: "User_role_id_fkey")
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
  Owner
}

enum course_level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum enrollment_status {
  ENROLLED
  COMPLETED
  CANCELLED
}

enum order_status {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum user_role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum userrole {
  STUDENT
  INSTRUCTOR
  ADMIN
}
